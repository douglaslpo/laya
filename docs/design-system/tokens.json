{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Laya design tokens (referência). Fonte da verdade: ui/src/app.css e ui/src/lib/utils/cardVisuals.ts.",
  "color": {
    "brand": {
      "orange": { "$value": "oklch(0.775 0.130 63)", "$description": "#f6ac69 — acento primário" },
      "gold": { "$value": "oklch(0.810 0.120 80)" },
      "peach": { "$value": "oklch(0.905 0.065 72)" },
      "coral": { "$value": "oklch(0.740 0.155 50)" },
      "amber": { "$value": "oklch(0.700 0.180 58)" },
      "sand": { "$value": "oklch(0.885 0.045 78)" },
      "blush": { "$value": "oklch(0.940 0.035 70)" },
      "terracotta": { "$value": "oklch(0.620 0.135 45)" }
    },
    "surface": {
      "dark": {
        "50": { "$value": "oklch(0.970 0.008 65)" },
        "100": { "$value": "oklch(0.920 0.010 64)" },
        "200": { "$value": "oklch(0.840 0.011 62)" },
        "300": { "$value": "oklch(0.740 0.013 60)" },
        "400": { "$value": "oklch(0.630 0.013 58)" },
        "500": { "$value": "oklch(0.520 0.012 56)" },
        "600": { "$value": "oklch(0.420 0.011 54)" },
        "700": { "$value": "oklch(0.340 0.009 52)" },
        "800": { "$value": "oklch(0.265 0.008 50)" },
        "900": { "$value": "oklch(0.185 0.007 48)" },
        "950": { "$value": "oklch(0.120 0.005 46)" }
      },
      "light": {
        "50": { "$value": "oklch(0.220 0.018 44)" },
        "100": { "$value": "oklch(0.310 0.017 48)" },
        "200": { "$value": "oklch(0.410 0.016 53)" },
        "300": { "$value": "oklch(0.510 0.014 58)" },
        "400": { "$value": "oklch(0.615 0.012 62)" },
        "500": { "$value": "oklch(0.720 0.009 65)" },
        "600": { "$value": "oklch(0.810 0.007 68)" },
        "700": { "$value": "oklch(0.880 0.006 70)" },
        "800": { "$value": "oklch(0.935 0.006 72)" },
        "900": { "$value": "oklch(0.970 0.005 74)" },
        "950": { "$value": "oklch(0.990 0.003 78)" }
      }
    },
    "status": {
      "pending": { "rgb": "217 119 6", "dot": "yellow", "shape": "half-circle", "pulse": true, "label": "Processing" },
      "ready": { "rgb": "217 119 6", "dot": "amber", "shape": "circle", "label": "Ready" },
      "agent_running": { "rgb": "139 92 246", "dot": "violet", "shape": "circle", "pulse": true, "label": "Agent Running" },
      "awaiting_input": { "rgb": "127 119 221", "dot": "violet", "shape": "triangle", "label": "Input Needed" },
      "done": { "rgb": "99 153 34", "dot": "green", "shape": "check", "label": "Done" },
      "failed": { "rgb": "244 63 110", "dot": "red", "shape": "x", "label": "Failed" },
      "dismissed": { "rgb": "120 113 108", "dot": "surface-500", "shape": "dash", "label": "Dismissed" },
      "archived": { "rgb": "120 113 108", "dot": "surface-600", "shape": "square-outline", "label": "Archived" }
    },
    "statusDot": {
      "dark": {
        "amber": { "$value": "oklch(0.75 0.17 65)" },
        "yellow": { "$value": "oklch(0.80 0.16 90)" },
        "green": { "$value": "oklch(0.72 0.19 145)" },
        "red": { "$value": "oklch(0.55 0.22 27)" },
        "violet": { "$value": "oklch(0.65 0.20 285)" },
        "sky": { "$value": "oklch(0.68 0.14 295)" }
      }
    },
    "persona": {
      "ENGINEER": "violet",
      "COMMS": "emerald",
      "OPS": "amber",
      "SALES": "sky",
      "HR": "rose",
      "FINANCE": "teal"
    },
    "priority": {
      "CRITICAL": { "label": "CRIT", "classes": "bg-red-600 text-red-50" },
      "HIGH": { "label": "HIGH", "classes": "bg-rose-500/25 text-rose-300" },
      "MEDIUM": { "label": "MED", "classes": "bg-amber-500/20 text-amber-300" },
      "LOW": { "label": "LOW", "classes": "bg-surface-700/40 text-surface-400" }
    },
    "platform": {
      "gmail": { "$value": "#EA4335" },
      "github": { "$value": "#9CA3AF" },
      "bitbucket": { "$value": "#2684FF" },
      "bitbucket_server": { "$value": "#2684FF" },
      "jira": { "$value": "#2684FF" },
      "outlook": { "$value": "#0078D4" },
      "outlook_calendar": { "$value": "#0078D4" },
      "calendar": { "$value": "#1A73E8" },
      "google_calendar": { "$value": "#1A73E8" },
      "slack": { "$value": "#611F69" },
      "linear": { "$value": "#5E6AD2" },
      "notion": { "$value": "#8B8B85" },
      "laya": { "$value": "#F97316" },
      "fallback": { "$value": "#6B7280" }
    },
    "accessible": {
      "ready": { "$value": "#0EA5E9" },
      "done": { "$value": "#EAB308" },
      "agent": { "$value": "#A855F7" },
      "failed": { "$value": "#475569" }
    }
  },
  "typography": {
    "family": {
      "base": { "$value": "'Inter', system-ui, sans-serif" },
      "mono": { "$value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
    },
    "baseSize": { "$value": "13px", "$description": "--laya-font-base, ajustável 12–15px" },
    "scale": {
      "heading": { "$value": "calc(var(--laya-font-base) + 5px)", "lineHeight": 1.4 },
      "base": { "$value": "var(--laya-font-base)", "lineHeight": 1.5 },
      "secondary": { "$value": "calc(var(--laya-font-base) - 2px)", "lineHeight": 1.5 },
      "micro": { "$value": "calc(var(--laya-font-base) - 3px)", "lineHeight": 1.4 }
    }
  },
  "size": {
    "headerHeight": { "$value": "38px" },
    "footerHeight": { "$value": "33px" },
    "feedCardWidth": { "$value": "320px" },
    "feedColumnGap": { "$value": "16px" },
    "detailPanelWidth": { "$value": "420px" },
    "chatWidth": { "$value": "460px" }
  },
  "radius": {
    "card": { "$value": "12px" },
    "menu": { "$value": "8px" },
    "control": { "$value": "6px" },
    "badge": { "$value": "4px" },
    "glassSection": { "$value": "14px" },
    "capsule": { "$value": "7px" }
  },
  "zIndex": {
    "titlebar": 9999,
    "titlebarMenuBackdrop": 9998,
    "nestedModal": 200,
    "dropdown": 100,
    "modal": 50,
    "chat": 40
  },
  "motion": {
    "tooltip": { "$value": "75ms" },
    "micro": { "$value": "120ms" },
    "dropdown": { "$value": "150ms" },
    "route": { "$value": "150ms" },
    "glassHover": { "$value": "180ms" },
    "cardExit": { "$value": "250ms" },
    "flip": { "$value": "300ms" },
    "panel": { "$value": "300ms" }
  }
}
